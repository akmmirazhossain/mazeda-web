{
  "folders": [
    {
      "name": "mazeda-web",
      "path": "./"
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#013634",
      "titleBar.activeForeground": "#ffffff",
      "titleBar.inactiveBackground": "#013634"
    },
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run DEV",
        "type": "shell",
        "command": "npm run dev -- -p 3030",
        "options": {
          "cwd": "${workspaceFolder:mazeda-web}"
        },
        "runOptions": {
          "runOn": "folderOpen"
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "focus": true
        }
      }
    ]
  }
}